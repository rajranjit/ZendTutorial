<?php
$title = 'Delete album';
$this->headTitle($title);
?>
<h1><?php echo $this->escapeHtml($title); ?></h1>

<div class="alert alert-warning">
    <strong>Warning!</strong> Are you sure you want to remove
    <em><?php echo $this->escapeHtml($album->title); ?></em> by
    <em><?php echo $this->escapeHtml($album->artist); ?></em>?
</div>

<?php
$url = $this->url('album', array(
    'action' => 'delete',
    'id'     => $this->id,
));
?>
<form action="<?php echo $url; ?>" method="post">
    <input type="hidden" name="id" value="<?php echo (int) $album->id; ?>" />
    <button type="submit" name="del" value="Yes" class="btn btn-danger">Yes, remove it</button>
    <button type="submit" name="del" value="No" class="btn btn-default">Cancel</button>
</form>
